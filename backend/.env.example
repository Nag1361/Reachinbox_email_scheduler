# =================================
# Server
# =================================
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://127.0.0.1:5173
BACKEND_URL=http://127.0.0.1:3000

# =================================
# MySQL
# =================================
DATABASE_URL=mysql://reachinbox:reachinbox@localhost:3306/reachinbox

# =================================
# Redis
# =================================
REDIS_URL=redis://localhost:6379

# =================================
# Elasticsearch
# =================================
ELASTICSEARCH_URL=http://localhost:9200

# =================================
# Google OAuth (supply secrets in the untracked .env file)
# =================================
# Configure these in a Google OAuth web application; do not commit credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://127.0.0.1:3000/api/auth/google/callback

# =================================
# JWT
# =================================
# Set a strong random value outside development.
JWT_SECRET=

# =================================
# Ethereal SMTP test account. Leave credentials blank to create a test account in development.
# =================================
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASSWORD=

# =================================
# Slack OAuth (supply secrets in the untracked .env file)
# =================================
# Configure these in a Slack app; do not commit credentials.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://127.0.0.1:3000/api/slack/callback

# =================================
# =================================
# Worker / Rate Limiting
# =================================
WORKER_CONCURRENCY=5
MIN_SEND_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=200
