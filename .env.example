# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://127.0.0.1:5173
BACKEND_URL=http://127.0.0.1:3000

# MySQL
MYSQL_DATABASE=reachinbox
MYSQL_USER=reachinbox
MYSQL_PASSWORD=reachinbox
MYSQL_ROOT_PASSWORD=root
DATABASE_URL=mysql://reachinbox:reachinbox@localhost:3306/reachinbox

# Redis
REDIS_URL=redis://localhost:6379

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# Google OAuth web client; configure its callback to this backend URL
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://127.0.0.1:3000/api/auth/google/callback

# Configure a strong random value for all deployed environments.
JWT_SECRET=

# Slack app OAuth; configure its redirect URL to this backend URL
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://127.0.0.1:3000/api/slack/callback

# Ethereal SMTP
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASSWORD=

# Worker and sender rate limits
WORKER_CONCURRENCY=5
MIN_SEND_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=200
